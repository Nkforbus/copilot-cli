# Supabase Postgres connection settings.
# Copy this file to .env (in the scripts/ directory) and fill in real values.
# Never commit the .env file itself.

# Option 1: full connection string (recommended for Supabase)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# Option 2: discrete fields (used only if DATABASE_URL is not set)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Set to "disable" only for local/non-TLS Postgres instances.
PGSSLMODE=require
